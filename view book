public void viewBooks() {
    try {
        Connection con = DBConnection.getConnection();
        String query = "SELECT * FROM books";

        Statement st = con.createStatement();
        ResultSet rs = st.executeQuery(query);

        while (rs.next()) {
            System.out.println(
                rs.getInt("book_id") + " " +
                rs.getString("title") + " " +
                rs.getString("author") + " " +
                rs.getInt("quantity")
            );
        }
    } catch (Exception e) {
        System.out.println(e);
    }
}
